+        val manual=Sic22FormState(signalCodeSource=SignalCodeSource.MANUAL,signalCode="LOCAL",signalDescription="Placa local")
+        assertEquals(manual,manual.selectSignalSource(SignalCodeSource.MANUAL))
+    }
